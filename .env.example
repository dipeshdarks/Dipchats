# ========================================
# DipChats Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ---- Frontend (Vite) ----
# Set these in Vercel Project Settings > Environment Variables
# Leave empty in development to use Vite proxy (relative URLs)

# API base URL (no trailing slash)
# Production: https://your-backend-domain.com
# Development: leave empty (uses Vite proxy)
VITE_API_URL=

# WebSocket URL (full URL including ws:// or wss://)
# Production: wss://your-backend-domain.com/ws
# Development: leave empty (uses Vite proxy)
VITE_WS_URL=

# ---- Backend (Fastify) ----

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
# Production: Use a managed provider (Neon, Railway, Supabase, etc.)
DATABASE_URL=postgresql://dipchats:dipchats_dev@localhost:5432/dipchats

# Redis
# Production: Use Upstash, Railway Redis, or similar
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
# Production: Use AWS S3, Cloudflare R2, or similar
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dipchats_minio
MINIO_SECRET_KEY=dipchats_minio_secret
MINIO_BUCKET=dipchats
MINIO_USE_SSL=false

# CORS (comma-separated origins allowed)
# Production: https://dipchats.vercel.app,https://dipchats.com
# Development: leave empty (defaults to localhost:3000 and localhost:5173)
CORS_ORIGIN=

# Session
SESSION_SECRET=change-me-in-production-use-a-real-secret
SESSION_TTL=3600

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=image/*,video/*,audio/*,application/pdf,application/zip,text/plain

# Logging
LOG_LEVEL=info
