# ========================================
# DipChats Environment Configuration
# ========================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://dipchats:dipchats_dev@localhost:5432/dipchats

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dipchats_minio
MINIO_SECRET_KEY=dipchats_minio_secret
MINIO_BUCKET=dipchats
MINIO_USE_SSL=false

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_PAYLOAD=1048576

# Session
SESSION_SECRET=change-me-in-production-use-a-real-secret
SESSION_TTL=3600

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=image/*,video/*,audio/*,application/pdf,application/zip,text/plain

# Logging
LOG_LEVEL=info
